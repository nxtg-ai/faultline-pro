{
  "name": "faultline-pro-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Faultline Pro — monorepo workspace root. Published package: packages/cli (@nxtg/faultline).",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspace=packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "scan": "tsx cli/index.ts scan",
    "faultline": "tsx cli/index.ts",
    "version-parity": "node scripts/version-parity.mjs"
  },
  "keywords": [
    "ai",
    "trust",
    "safety",
    "verification",
    "claims",
    "eu-ai-act",
    "compliance",
    "llm",
    "gemini",
    "claude",
    "ai-safety",
    "ai-trust",
    "llm-testing",
    "claim-verification",
    "hallucination-detection",
    "ai-compliance",
    "ai-forensics",
    "ai-audit",
    "sarif",
    "red-team",
    "foundation-model",
    "openai",
    "anthropic"
  ],
  "author": "Asif Waliuddin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxtg-ai/faultline-pro.git"
  },
  "homepage": "https://github.com/nxtg-ai/faultline-pro#readme",
  "bugs": {
    "url": "https://github.com/nxtg-ai/faultline-pro/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "js-yaml": "^4.1.1",
    "ora": "^9.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
