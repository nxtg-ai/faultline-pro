    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://faultline-api.fly.dev/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Your Faultline API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
